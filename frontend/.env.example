# MCP Hub Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend origin the console's server forwards its /api/v1 calls to (next.config.ts rewrites), so the refresh token
# cookie stays first-party. Usually the origin of NEXT_PUBLIC_API_BASE_URL; inside Docker Compose, http://backend:8000.
# Read at build time: the rewrite is baked into the build, so rebuild after changing it.
API_PROXY_TARGET=http://localhost:8000
