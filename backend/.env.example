# MCP Hub Backend Environment Variables

# General Settings
PROJECT_NAME="MCP Hub Backend"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS settings for frontend (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Connection & Execution settings
DEFAULT_CONNECTION_TIMEOUT=15.0
DEFAULT_EXECUTION_TIMEOUT=30.0
MAX_CONCURRENT_EXECUTIONS_PER_SERVER=5

# Approved executables for stdio transport security
ALLOWED_STDIO_EXECUTABLES=["python", "python3", "python3.12", "uv", "node", "npx", "bun", "docker"]

# SSRF protection settings
ALLOW_PRIVATE_NETWORK_HTTP=true

# Security: Database Encryption Key for sensitive secrets and configs (Fernet base64 or secure passphrase)
ENCRYPTION_KEY="zR-m7i44PyR_vuRxaTSdRffxFU_mt_SH3PFKVnZFl5k="

# Database configuration (SQLite with aiosqlite)
DATABASE_URL="sqlite+aiosqlite:///./mcp_hub.db"

# Observability
LOG_LEVEL="INFO"
