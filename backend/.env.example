# MCP Hub Backend Environment Variables

# --- App ---
API_V1_STR="/api/v1"
DEBUG=false
# development, test or production
ENVIRONMENT="development"
LOG_LEVEL="INFO"
PROJECT_NAME="MCP Hub Backend"
VERSION="0.1.0"

# --- Public URLs & CORS ---
# Origins allowed to call the API (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
# Where the console runs; the OAuth callback hands the result back to it
FRONTEND_BASE_URL="http://localhost:3000"
# Where browsers reach this API; the OAuth callback is PUBLIC_API_BASE_URL/api/v1/oauth/callback
PUBLIC_API_BASE_URL="http://localhost:8000"

# --- Database ---
# PostgreSQL with asyncpg and pgvector
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_hub"

# --- Authentication & console sessions ---
# Console access and refresh tokens (ADR-0009)
# Console access tokens are short-lived; the console renews them with a refresh token
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Set to false on any network-exposed deployment: registered users can add stdio servers
ALLOW_SELF_SIGNUP=true
# At least 32 characters
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
# strict, lax or none; "none" (needs REFRESH_COOKIE_SECURE) only when the console and API are on different sites
REFRESH_COOKIE_SAMESITE="strict"
# true behind HTTPS
REFRESH_COOKIE_SECURE=false
# A refresh token unused for this many days expires (every refresh issues a new one)
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Downstream MCP servers ---
# Approved executables for stdio transport security
ALLOWED_STDIO_EXECUTABLES=["python", "python3", "python3.12", "uv", "node", "npx", "bun", "docker"]
# SSRF protection: whether streamable-http servers may be on private networks
ALLOW_PRIVATE_NETWORK_HTTP=true
# Seconds
DEFAULT_CONNECTION_TIMEOUT=15.0
# Seconds
DEFAULT_EXECUTION_TIMEOUT=30.0
MAX_CONCURRENT_EXECUTIONS_PER_SERVER=5

# --- OAuth connections ---
# Hosted MCP servers (ADR-0008)
# Client credentials for catalog providers without dynamic client registration, keyed by provider id
OAUTH_CLIENTS={}
# Fernet key for stored OAuth tokens: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY="replace-with-a-generated-fernet-key"
# A sign-in left open longer than this is abandoned
OAUTH_FLOW_TIMEOUT_SECONDS=600

# --- Tool search embeddings ---
# Vectors are stored in pgvector (ADR-0006, ADR-0010). Changing the model or dimension needs a migration that
# resizes discovered_tools.embedding.
# Local provider only; relative paths are resolved against the backend directory
EMBEDDING_CACHE_DIR=".cache/fastembed"
# Must equal the selected model's dimension and the column size
EMBEDDING_DIMENSION=384
# A key of EMBEDDING_MODELS; the same model whichever provider runs it
EMBEDDING_MODEL="bge-small-en-v1.5"
# Model catalog (JSON): name -> dimension, fastembed id, Workers AI id and pooling
EMBEDDING_MODELS='{"bge-small-en-v1.5": {"dimension": 384, "local_id": "BAAI/bge-small-en-v1.5", "cloudflare_id": "@cf/baai/bge-small-en-v1.5", "cloudflare_pooling": "cls"}}'
# "local" (fastembed in this process) or "cloudflare" (Workers AI API); switching needs no re-embedding
EMBEDDING_PROVIDER="local"
# pgvector iterative HNSW scans so filters cannot cut search results short: strict_order or off
HNSW_ITERATIVE_SCAN="strict_order"

# --- Cloudflare Workers AI ---
# Used when EMBEDDING_PROVIDER="cloudflare" (the token needs the Workers AI Read permission)
CLOUDFLARE_ACCOUNT_ID=""
# Cloudflare API root (https only)
CLOUDFLARE_API_BASE_URL="https://api.cloudflare.com/client/v4"
CLOUDFLARE_API_TOKEN=""
# Between polls of a queued batch (EMBEDDING_BACKFILL_QUEUED)
CLOUDFLARE_BATCH_POLL_INTERVAL_SECONDS=5
# A queued batch not done by then is abandoned; the next backfill resubmits
CLOUDFLARE_BATCH_TIMEOUT_SECONDS=600
# Per request
CLOUDFLARE_REQUEST_TIMEOUT_SECONDS=30

# --- Background jobs ---
# APScheduler jobs; every job must be safe to run on several hub instances (ADR-0005)
# Embedding backfill: embed Tools stored without an embedding (ADR-0006)
# Tools per round
EMBEDDING_BACKFILL_BATCH=64
EMBEDDING_BACKFILL_INTERVAL_MINUTES=10
EMBEDDING_BACKFILL_JOB_ID="backfill-tool-embeddings"
EMBEDDING_BACKFILL_MISFIRE_GRACE_SECONDS=300
# Use the provider's batch queue (Cloudflare Batch API): slower, survives capacity shortages
EMBEDDING_BACKFILL_QUEUED=true

# Refresh token purge: delete expired console refresh tokens (ADR-0009)
REFRESH_TOKEN_PURGE_INTERVAL_MINUTES=60
REFRESH_TOKEN_PURGE_JOB_ID="purge-expired-refresh-tokens"
REFRESH_TOKEN_PURGE_MISFIRE_GRACE_SECONDS=300

# Session sweep: complete idle Sessions (ADR-0005)
# JSON of APScheduler CronTrigger fields, UTC
SESSION_SWEEP_CRON='{"minute": "*"}'
SESSION_SWEEP_JOB_ID="complete-idle-sessions"
SESSION_SWEEP_MISFIRE_GRACE_SECONDS=30
