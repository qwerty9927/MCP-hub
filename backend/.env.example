# MCP Hub Backend Environment Variables

# General Settings
PROJECT_NAME="MCP Hub Backend"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# CORS settings for frontend (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Connection & Execution settings
DEFAULT_CONNECTION_TIMEOUT=15.0
DEFAULT_EXECUTION_TIMEOUT=30.0
MAX_CONCURRENT_EXECUTIONS_PER_SERVER=5

# Approved executables for stdio transport security
ALLOWED_STDIO_EXECUTABLES=["python", "python3", "python3.12", "uv", "node", "npx", "bun", "docker"]

# SSRF protection settings
ALLOW_PRIVATE_NETWORK_HTTP=true

# Database configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_hub"

# Authentication
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to false on any network-exposed deployment: registered users can add stdio servers
ALLOW_SELF_SIGNUP=true

# Observability
LOG_LEVEL="INFO"

# Tool search embeddings: a local fastembed model; vectors are stored in pgvector.
# Changing the model or dimension needs a migration that resizes discovered_tools.embedding.
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=".cache/fastembed"

# OAuth connections to hosted MCP servers (ADR-0008)
# Fernet key for stored OAuth tokens: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY="replace-with-a-generated-fernet-key"
# Where browsers reach this API (the OAuth callback is PUBLIC_API_BASE_URL/api/v1/oauth/callback) and the console
PUBLIC_API_BASE_URL="http://localhost:8000"
FRONTEND_BASE_URL="http://localhost:3000"
# Client credentials for catalog providers without dynamic client registration, keyed by provider id
OAUTH_CLIENTS={}
# A sign-in left open longer than this is abandoned
OAUTH_FLOW_TIMEOUT_SECONDS=600
