  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "email",
      "value": "you@example.com"
    },
    {
      "key": "password",
      "value": "change-me-please"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 401) {",
          "    pm.test(\"Not authenticated: run 'Login' (REST) or 'Create MCP API Key' (/mcp) in '0. Account & API Key'\", () => { throw new Error('401'); });",
          "}"
        ]
      }
    }
  ]
}
