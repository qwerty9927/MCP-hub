[
    {
        "label": "FastAPI: Run & Debug MCP Hub",
        "adapter": "Debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
        "cwd": "$ZED_WORKTREE_ROOT/backend",
        "python": "$ZED_WORKTREE_ROOT/backend/.venv/bin/python",
    },
    {
        "label": "Python: Debug Current File",
        "adapter": "Debugpy",
        "request": "launch",
        "program": "$ZED_FILE",
        "cwd": "$ZED_FILE_DIR",
        "python": "$ZED_WORKTREE_ROOT/backend/.venv/bin/python",
    },
    {
        "label": "Pytest: Run All Tests",
        "adapter": "Debugpy",
        "request": "launch",
        "module": "pytest",
        "args": ["-v"],
        "cwd": "$ZED_WORKTREE_ROOT/backend",
        "python": "$ZED_WORKTREE_ROOT/backend/.venv/bin/python",
    },
    {
        "label": "Python: Attach to Process (Port 5678)",
        "adapter": "Debugpy",
        "request": "attach",
        "tcp_connection": {
            "host": "127.0.0.1",
            "port": 5678,
        },
    },
]
