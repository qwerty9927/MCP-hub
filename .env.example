# Optional Docker Compose overrides (docker-compose.yml). Copy to .env only if you need to change these.
# The apps' own settings live in backend/.env and frontend/.env, which the services read directly.
# The backend reads only backend/.env, so backend settings placed here have no effect on it.

# Host ports. Compose derives the API URL in the console bundle and the backend's CORS_ORIGINS /
# PUBLIC_API_BASE_URL / FRONTEND_BASE_URL from these; run `docker compose up -d --build` after changing them.
BACKEND_PORT=8000
FRONTEND_PORT=3000
