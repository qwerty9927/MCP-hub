# Optional Docker Compose overrides (docker-compose.yml). Copy to .env only if you need to change these.
# The apps' own settings live in backend/.env and frontend/.env, which the services read directly.
#
# Only use names that are not backend settings here: the backend also reads ../.env when run from backend/,
# so a name like DATABASE_URL or JWT_SECRET in this file would override backend/.env during local development.

# Database container credentials. The backend's DATABASE_URL is built from these inside compose.
# The database port is not published, but set a real password on any shared machine.
# Used in a connection URL, so avoid characters that need URL encoding (@ : / ? #).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mcp_hub
# Where the database files live: the named volume `postgres_data` by default, or an absolute host folder that
# already holds a Postgres 17 data directory. Stop any other Postgres using that folder first.
# POSTGRES_DATA=/absolute/path/to/postgres_data

# Host ports. If you change them, also update CORS_ORIGINS / PUBLIC_API_BASE_URL / FRONTEND_BASE_URL in
# backend/.env and NEXT_PUBLIC_API_BASE_URL in frontend/.env.
BACKEND_PORT=8000
FRONTEND_PORT=3000
